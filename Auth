/* ============================================================
   TaskNext — auth.js
   Client-side demo authentication.

   IMPORTANT: This is a front-end demonstration only. Passwords
   are stored in plain text inside localStorage purely so the
   app can run without a backend. This pattern must never be
   used for a real product — a real app needs a server that
   hashes credentials and issues sessions.
   ============================================================ */

/* ---------- account storage ---------- */
function getUsers(){
  return readJSON(STORAGE_KEYS.USERS, []);
}
function saveUsers(users){
  return writeJSON(STORAGE_KEYS.USERS, users);
}
function findUserByUsername(username){
  const uname = username.trim().toLowerCase();
  return getUsers().find(u => u.username.toLowerCase() === uname);
}

function getCurrentUsername(){
  return localStorage.getItem(STORAGE_KEYS.CURRENT_USER);
}
function getCurrentUser(){
  const uname = getCurrentUsername();
  if(!uname) return null;
  return findUserByUsername(uname) || null;
}
function setCurrentUsername(username){
  localStorage.setItem(STORAGE_KEYS.CURRENT_USER, username);
}
function clearCurrentUsername(){
  localStorage.removeItem(STORAGE_KEYS.CURRENT_USER);
}

/* Redirect guard for pages that require a logged-in user */
function requireAuth(){
  if(!getCurrentUsername() || !getCurrentUser()){
    window.location.href = 'index.html';
  }
}
/* Redirect guard for auth pages: bounce logged-in users straight in */
function redirectIfAuthed(){
  if(getCurrentUsername() && getCurrentUser()){
    window.location.href = 'dashboard.html';
  }
}

function logout(){
  clearCurrentUsername();
  window.location.href = 'index.html';
}

/* ---------- field-level validation helpers ---------- */
function setFieldError(inputEl, message){
  const wrap = inputEl.closest('.field');
  const errEl = wrap.querySelector('.field-error');
  inputEl.classList.add('is-error');
  if(errEl){
    errEl.textContent = message;
    errEl.classList.add('show');
  }
}
function clearFieldError(inputEl){
  const wrap = inputEl.closest('.field');
  const errEl = wrap.querySelector('.field-error');
  inputEl.classList.remove('is-error');
  if(errEl){
    errEl.textContent = '';
    errEl.classList.remove('show');
  }
}
function clearAllErrors(form){
  form.querySelectorAll('input').forEach(clearFieldError);
}

/* ---------- Register page ---------- */
function initRegisterForm(){
  const form = document.getElementById('register-form');
  if(!form) return;
  redirectIfAuthed();

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    clearAllErrors(form);

    const fullNameEl = form.elements['fullName'];
    const usernameEl = form.elements['username'];
    const passwordEl = form.elements['password'];
    const confirmEl = form.elements['confirmPassword'];

    const fullName = fullNameEl.value.trim();
    const username = usernameEl.value.trim();
    const password = passwordEl.value;
    const confirmPassword = confirmEl.value;

    let hasError = false;

    if(!fullName){
      setFieldError(fullNameEl, 'Enter your full name.');
      hasError = true;
    }
    if(!username){
      setFieldError(usernameEl, 'Choose a username.');
      hasError = true;
    } else if(!/^[a-zA-Z0-9_.]{3,20}$/.test(username)){
      setFieldError(usernameEl, '3–20 characters: letters, numbers, "_" or "."');
      hasError = true;
    } else if(findUserByUsername(username)){
      setFieldError(usernameEl, 'That username is already taken.');
      hasError = true;
    }
    if(!password){
      setFieldError(passwordEl, 'Create a password.');
      hasError = true;
    } else if(password.length < 6){
      setFieldError(passwordEl, 'Use at least 6 characters.');
      hasError = true;
    }
    if(!confirmPassword){
      setFieldError(confirmEl, 'Confirm your password.');
      hasError = true;
    } else if(password && confirmPassword !== password){
      setFieldError(confirmEl, 'Passwords do not match.');
      hasError = true;
    }

    if(hasError){
      showToast('Please fix the highlighted fields.', 'error');
      return;
    }

    const users = getUsers();
    users.push({ fullName, username, password });
    saveUsers(users);
    writeJSON(STORAGE_KEYS.TASKS_PREFIX + username, []);

    showToast('Account created — please sign in.', 'success');
    setTimeout(() => { window.location.href = 'index.html?registered=1'; }, 700);
  });
}

/* ---------- Login page ---------- */
function initLoginForm(){
  const form = document.getElementById('login-form');
  if(!form) return;
  redirectIfAuthed();

  const params = new URLSearchParams(window.location.search);
  if(params.get('registered') === '1'){
    showToast('Account created. Sign in to continue.', 'success');
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    clearAllErrors(form);

    const usernameEl = form.elements['username'];
    const passwordEl = form.elements['password'];
    const username = usernameEl.value.trim();
    const password = passwordEl.value;

    let hasError = false;
    if(!username){
      setFieldError(usernameEl, 'Enter your username.');
      hasError = true;
    }
    if(!password){
      setFieldError(passwordEl, 'Enter your password.');
      hasError = true;
    }
    if(hasError) return;

    const user = findUserByUsername(username);
    if(!user || user.password !== password){
      setFieldError(passwordEl, 'Username or password is incorrect.');
      showToast('Sign-in failed. Check your details.', 'error');
      return;
    }

    setCurrentUsername(user.username);
    showToast(`Welcome back, ${user.fullName.split(' ')[0]}.`, 'success');
    setTimeout(() => { window.location.href = 'dashboard.html'; }, 450);
  });
}

document.addEventListener('DOMContentLoaded', () => {
  initLoginForm();
  initRegisterForm();
});