<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard · TaskNext</title>
<link rel="stylesheet" href="style.css">
</head>
<body>

<div class="app-shell">

  <!-- ============ Sidebar ============ -->
  <aside class="app-sidebar">
    <span class="wordmark">
      <span class="wordmark__mark">
        <svg viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.2 11.8L13 4.2" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      Task<span class="wordmark__next">Next</span>
    </span>

    <nav class="nav-group">
      <span class="nav-label">Workspace</span>
      <div class="nav-link" data-view="dashboard">
        <svg viewBox="0 0 20 20" fill="none"><rect x="3" y="3" width="6.5" height="6.5" rx="1.3" stroke="currentColor" stroke-width="1.5"/><rect x="10.5" y="3" width="6.5" height="6.5" rx="1.3" stroke="currentColor" stroke-width="1.5"/><rect x="3" y="10.5" width="6.5" height="6.5" rx="1.3" stroke="currentColor" stroke-width="1.5"/><rect x="10.5" y="10.5" width="6.5" height="6.5" rx="1.3" stroke="currentColor" stroke-width="1.5"/></svg>
        Dashboard
      </div>
      <div class="nav-link" data-view="tasks">
        <svg viewBox="0 0 20 20" fill="none"><path d="M4 6h12M4 10h12M4 14h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        My Tasks
        <span class="nav-count" id="count-tasks">0</span>
      </div>
    </nav>

    <nav class="nav-group">
      <span class="nav-label">Timeline</span>
      <div class="nav-link" data-view="today">
        <svg viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M10 6v4l2.6 2.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        Today
        <span class="nav-count" id="count-today">0</span>
      </div>
      <div class="nav-link" data-view="upcoming">
        <svg viewBox="0 0 20 20" fill="none"><path d="M4 4l12 6-12 6V4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
        Upcoming
        <span class="nav-count" id="count-upcoming">0</span>
      </div>
      <div class="nav-link" data-view="completed">
        <svg viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M6.8 10.2l2.1 2.1 4.3-4.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Completed
        <span class="nav-count" id="count-completed">0</span>
      </div>
    </nav>

    <div class="sidebar-footer">
      <button type="button" class="sidebar-logout" data-logout>
        <svg viewBox="0 0 20 20" fill="none"><path d="M8 4H5.5A1.5 1.5 0 004 5.5v9A1.5 1.5 0 005.5 16H8M13 13l3-3-3-3M16 10H8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Log out
      </button>
    </div>
  </aside>
  <div class="sidebar-scrim" data-menu-toggle></div>

  <!-- ============ Header ============ -->
  <header class="app-header">
    <button type="button" class="app-header__menu-btn icon-btn" data-menu-toggle aria-label="Toggle menu">
      <svg viewBox="0 0 20 20" fill="none"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>

    <div class="app-search">
      <svg viewBox="0 0 20 20" fill="none"><circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.6"/><path d="M13.3 13.3L17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      <input type="text" id="global-search" placeholder="Search tasks by title or description…">
    </div>

    <div class="app-header__right">
      <button type="button" class="btn btn-primary header-add-btn" data-open-add-task>
        <svg viewBox="0 0 16 16" fill="none" width="15" height="15"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        Add task
      </button>
      <div class="user-chip">
        <span class="user-avatar" data-user-initials>?</span>
        <span class="user-chip__name" data-user-name>—</span>
      </div>
    </div>
  </header>

  <!-- ============ Main ============ -->
  <main class="app-main">

    <!-- ---------- Dashboard view ---------- -->
    <section class="view" id="view-dashboard">
      <div class="view-head">
        <div>
          <span class="view-eyebrow">Overview</span>
          <h1>Welcome back, <span data-user-first>there</span>.</h1>
          <p class="view-sub">Here's where things stand across your workspace.</p>
        </div>
        <button type="button" class="btn btn-primary" data-open-add-task>
          <svg viewBox="0 0 16 16" fill="none" width="15" height="15"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          Add task
        </button>
      </div>

      <div class="stat-grid">
        <div class="stat-card">
          <div class="stat-card__label"><span class="stat-dot" style="background:#33578C"></span>Total tasks</div>
          <div class="stat-card__value" id="stat-total">0</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__label"><span class="stat-dot" style="background:#1F6F5C"></span>Completed</div>
          <div class="stat-card__value" id="stat-completed">0</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__label"><span class="stat-dot" style="background:#A6791F"></span>Pending</div>
          <div class="stat-card__value" id="stat-pending">0</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__label"><span class="stat-dot" style="background:#B3412A"></span>High priority</div>
          <div class="stat-card__value" id="stat-high">0</div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-head">
          <h2>Today's tasks</h2>
          <span class="view-sub" data-goto="today" style="cursor:pointer;">View all →</span>
        </div>
        <div class="panel-body">
          <div class="task-list" id="dashboard-today-list"></div>
        </div>
      </div>
    </section>

    <!-- ---------- My Tasks view ---------- -->
    <section class="view" id="view-tasks">
      <div class="view-head">
        <div>
          <span class="view-eyebrow">Workspace</span>
          <h1>My Tasks</h1>
          <p class="view-sub">Every task you've created, in one place.</p>
        </div>
        <button type="button" class="btn btn-primary" data-open-add-task>
          <svg viewBox="0 0 16 16" fill="none" width="15" height="15"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          Add task
        </button>
      </div>

      <div class="toolbar">
        <div class="chip-row">
          <button type="button" class="chip active" data-filter="all">All</button>
          <button type="button" class="chip" data-filter="pending">Pending</button>
          <button type="button" class="chip" data-filter="completed">Completed</button>
          <button type="button" class="chip" data-filter="high">High priority</button>
          <button type="button" class="chip" data-filter="medium">Medium priority</button>
          <button type="button" class="chip" data-filter="low">Low priority</button>
          <button type="button" class="chip" data-filter="today">Due today</button>
        </div>
        <div class="select-wrap">
          <label for="sort-tasks">Sort</label>
          <select id="sort-tasks" class="sort-select">
            <option value="newest">Newest</option>
            <option value="oldest">Oldest</option>
            <option value="due">Due date</option>
            <option value="priority">Priority</option>
          </select>
        </div>
      </div>

      <div class="task-list" id="tasks-list"></div>
    </section>

    <!-- ---------- Today view ---------- -->
    <section class="view" id="view-today">
      <div class="view-head">
        <div>
          <span class="view-eyebrow">Timeline</span>
          <h1>Today</h1>
          <p class="view-sub">Tasks due today.</p>
        </div>
        <button type="button" class="btn btn-primary" data-open-add-task>
          <svg viewBox="0 0 16 16" fill="none" width="15" height="15"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          Add task
        </button>
      </div>
      <div class="toolbar">
        <div class="select-wrap" style="margin-left:0;">
          <label for="sort-today">Sort</label>
          <select id="sort-today" class="sort-select">
            <option value="newest">Newest</option>
            <option value="oldest">Oldest</option>
            <option value="due">Due date</option>
            <option value="priority">Priority</option>
          </select>
        </div>
      </div>
      <div class="task-list" id="today-list"></div>
    </section>

    <!-- ---------- Upcoming view ---------- -->
    <section class="view" id="view-upcoming">
      <div class="view-head">
        <div>
          <span class="view-eyebrow">Timeline</span>
          <h1>Upcoming</h1>
          <p class="view-sub">Tasks with a due date after today.</p>
        </div>
        <button type="button" class="btn btn-primary" data-open-add-task>
          <svg viewBox="0 0 16 16" fill="none" width="15" height="15"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          Add task
        </button>
      </div>
      <div class="toolbar">
        <div class="select-wrap" style="margin-left:0;">
          <label for="sort-upcoming">Sort</label>
          <select id="sort-upcoming" class="sort-select">
            <option value="newest">Newest</option>
            <option value="oldest">Oldest</option>
            <option value="due">Due date</option>
            <option value="priority">Priority</option>
          </select>
        </div>
      </div>
      <div class="task-list" id="upcoming-list"></div>
    </section>

    <!-- ---------- Completed view ---------- -->
    <section class="view" id="view-completed">
      <div class="view-head">
        <div>
          <span class="view-eyebrow">Timeline</span>
          <h1>Completed</h1>
          <p class="view-sub">Tasks you've already finished.</p>
        </div>
      </div>
      <div class="toolbar">
        <div class="select-wrap" style="margin-left:0;">
          <label for="sort-completed">Sort</label>
          <select id="sort-completed" class="sort-select">
            <option value="newest">Newest</option>
            <option value="oldest">Oldest</option>
            <option value="due">Due date</option>
            <option value="priority">Priority</option>
          </select>
        </div>
      </div>
      <div class="task-list" id="completed-list"></div>
    </section>

  </main>
</div>

<!-- ============ Add / Edit Task Modal ============ -->
<div class="modal-overlay" id="task-modal">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="task-modal-title">
    <div class="modal-head">
      <h2 id="task-modal-title">Add task</h2>
      <button type="button" class="modal-close" data-close-modal aria-label="Close">
        <svg viewBox="0 0 16 16" fill="none"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
    </div>
    <form id="task-form" novalidate>
      <div class="modal-body">
        <div class="field">
          <label for="task-title-input">Task title</label>
          <input type="text" id="task-title-input" name="title" placeholder="e.g. Prepare client presentation" maxlength="120">
          <span class="field-error"></span>
        </div>
        <div class="field">
          <label for="task-desc-input">Description</label>
          <textarea id="task-desc-input" name="description" placeholder="Add a short note about this task (optional)" maxlength="400"></textarea>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="task-due-input">Due date</label>
            <input type="date" id="task-due-input" name="dueDate">
          </div>
          <div class="field">
            <label>Priority</label>
            <input type="hidden" name="priority" value="medium">
            <div class="priority-picker">
              <div class="priority-opt" data-p="low">Low</div>
              <div class="priority-opt active" data-p="medium">Medium</div>
              <div class="priority-opt" data-p="high">High</div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-foot">
        <button type="button" class="btn btn-secondary" data-close-modal>Cancel</button>
        <button type="submit" class="btn btn-primary" id="task-save-btn">Save task</button>
      </div>
    </form>
  </div>
</div>

<!-- ============ Delete Confirmation Modal ============ -->
<div class="modal-overlay confirm-modal" id="confirm-modal">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title">
    <div class="modal-body" style="padding-top:22px;">
      <div class="confirm-icon">
        <svg viewBox="0 0 20 20" fill="none"><path d="M4 6h12M8 6V4.5A1.5 1.5 0 019.5 3h1A1.5 1.5 0 0112 4.5V6m-6 0v9a1.5 1.5 0 001.5 1.5h5A1.5 1.5 0 0014 15V6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h2 id="confirm-modal-title" style="font-size:16.5px;margin-bottom:6px;">Delete this task?</h2>
      <p style="color:var(--ink-soft);font-size:13.8px;">This will permanently remove <span id="confirm-task-name">this task</span>. This can't be undone.</p>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-secondary" data-close-confirm>Cancel</button>
      <button type="button" class="btn btn-danger-outline" id="confirm-delete-btn">Delete task</button>
    </div>
  </div>
</div>

<script src="utils.js"></script>
<script src="auth.js"></script>
<script src="script.js"></script>
</body>
</html>